{
  "id": "cpr-autofire-homebrew",
  "title": "Autofire Homebrew for Cyberpunk RED",
  "description": "Homebrew Autofire rules for Cyberpunk RED. Full Blast, adapted from Infernox-Ratchet's Adjustable Gas Piston: spend double ammunition to add 1 to each damage die (max 6) before the Autofire multiplier.",
  "version": "0.4.0",
  "compatibility": { "minimum": "12", "verified": "12.343", "maximum": "12" },
  "authors": [
    { "name": "Lukasz Dobbek", "url": "https://github.com/TheCadoc" }
  ],
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/full-blast-prompt.css"],
  "languages": [{ "lang": "en", "name": "English", "path": "lang/en.json" }],
  "packs": [
    {
      "name": "autofire-homebrew-items",
      "label": "Autofire Homebrew Items",
      "path": "packs/autofire-homebrew-items",
      "type": "Item",
      "system": "cyberpunk-red-core"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": { "verified": "0.92.4" }
      }
    ],
    "requires": [{ "id": "lib-wrapper", "type": "module" }]
  },
  "url": "https://github.com/TheCadoc/cpr-autofire-homebrew",
  "manifest": "https://github.com/TheCadoc/cpr-autofire-homebrew/releases/latest/download/module.json",
  "download": "https://github.com/TheCadoc/cpr-autofire-homebrew/releases/latest/download/module.zip",
  "bugs": "https://github.com/TheCadoc/cpr-autofire-homebrew/issues",
  "readme": "https://github.com/TheCadoc/cpr-autofire-homebrew/blob/main/README.md",
  "license": "https://github.com/TheCadoc/cpr-autofire-homebrew/blob/main/LICENSE",
  "changelog": "https://github.com/TheCadoc/cpr-autofire-homebrew/releases"
}
